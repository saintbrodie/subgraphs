erate":"randomize","strength":0.02}},{"id":209,"type":"GLSLShader","pos":[3120.7904329472094,1400.3156228621958],"size":[400,194],"flags":{"collapsed":true},"order":6,"mode":0,"inputs":[{"localized_name":"fragment_shader","name":"fragment_shader","type":"STRING","widget":{"name":"fragment_shader"},"link":null},{"localized_name":"size_mode","name":"size_mode","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"size_mode"},"link":null},{"label":"image0","localized_name":"image0","name":"images.image0","type":"IMAGE","link":199},{"label":"image1","localized_name":"image1","name":"images.image1","shape":7,"type":"IMAGE","link":null},{"label":"u_float0","localized_name":"u_float0","name":"floats.u_float0","shape":7,"type":"FLOAT","link":197},{"label":"u_float1","localized_name":"u_float1","name":"floats.u_float1","shape":7,"type":"FLOAT","link":198},{"label":"u_float2","localized_name":"u_float2","name":"floats.u_float2","shape":7,"type":"FLOAT","link":null},{"label":"u_int0","localized_name":"u_int0","name":"ints.u_int0","shape":7,"type":"INT","link":null},{"label":"u_bool0","localized_name":"u_bool0","name":"bools.u_bool0","shape":7,"type":"BOOLEAN","link":null},{"label":"u_curve0","localized_name":"u_curve0","name":"curves.u_curve0","shape":7,"type":"CURVE","link":null}],"outputs":[{"localized_name":"IMAGE0","name":"IMAGE0","type":"IMAGE","links":[200]},{"localized_name":"IMAGE1","name":"IMAGE1","type":"IMAGE","links":[]},{"localized_name":"IMAGE2","name":"IMAGE2","type":"IMAGE","links":[]},{"localized_name":"IMAGE3","name":"IMAGE3","type":"IMAGE","links":[]}],"properties":{"cnr_id":"comfy-core","ver":"0.22.0","Node name for S&R":"GLSLShader"},"widgets_values":["#version 300 es\nprecision highp float;\n\nuniform sampler2D u_image0;\nuniform float u_float0; // Brightness slider -100..100\nuniform float u_float1; // Contrast slider -100..100\n\nin vec2 v_texCoord;\nout vec4 fragColor;\n\nconst float MID_GRAY = 0.18;  // 18% reflectance\n\n// sRGB gamma 2.2 approximation\nvec3 srgbToLinear(vec3 c) {\n    return pow(max(c, 0.0), vec3(2.2));\n}\n\nvec3 linearToSrgb(vec3 c) {\n    return pow(max(c, 0.0), vec3(1.0/2.2));\n}\n\nfloat mapBrightness(float b) {\n    return clamp(b / 100.0, -1.0, 1.0);\n}\n\nfloat mapContrast(float c) {\n    return clamp(c / 100.0 + 1.0, 0.0, 2.0);\n}\n\nvoid main() {\n    vec4 orig = texture(u_image0, v_texCoord);\n\n    float brightness = mapBrightness(u_float0);\n    float contrast   = mapContrast(u_float1);\n\n    vec3 lin = srgbToLinear(orig.rgb);\n\n    lin = (lin - MID_GRAY) * contrast + brightness + MID_GRAY;\n\n    // Convert back to sRGB\n    vec3 result = linearToSrgb(clamp(lin, 0.0, 1.0));\n\n    fragColor = vec4(result, orig.a);\n}\n","from_input"],"widgets_values_named":{"fragment_shader":"#version 300 es\nprecision highp float;\n\nuniform sampler2D u_image0;\nuniform float u_float0; // Brightness slider -100..100\nuniform float u_float1; // Contrast slider -100..100\n\nin vec2 v_texCoord;\nout vec4 fragColor;\n\nconst float MID_GRAY = 0.18;  // 18% reflectance\n\n// sRGB gamma 2.2 approximation\nvec3 srgbToLinear(vec3 c) {\n    return pow(max(c, 0.0), vec3(2.2));\n}\n\nvec3 linearToSrgb(vec3 c) {\n    return pow(max(c, 0.0), vec3(1.0/2.2));\n}\n\nfloat mapBrightness(float b) {\n    return clamp(b / 100.0, -1.0, 1.0);\n}\n\nfloat mapContrast(float c) {\n    return clamp(c / 100.0 + 1.0, 0.0, 2.0);\n}\n\nvoid main() {\n    vec4 orig = texture(u_image0, v_texCoord);\n\n    float brightness = mapBrightness(u_float0);\n    float contrast   = mapContrast(u_float1);\n\n    vec3 lin = srgbToLinear(orig.rgb);\n\n    lin = (lin - MID_GRAY) * contrast + brightness + MID_GRAY;\n\n    // Convert back to sRGB\n    vec3 result = linearToSrgb(clamp(lin, 0.0, 1.0));\n\n    fragColor = vec4(result, orig.a);\n}\n","size_mode":"from_input"}},{"id":208,"type":"PrimitiveFloat","pos":[2796.193037021165,1323.2442258366739],"size":[270,58],"flags":{},"order":5,"mode":0,"inputs":[{"label":"brightness","localized_name":"v